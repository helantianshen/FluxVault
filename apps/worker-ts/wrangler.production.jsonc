{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxvault-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "account_id": "09d7105f82d5334496241c9ad210eecb",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vault-admin.gyvv.top",
      "custom_domain": true
    },
    {
      "pattern": "vault-api.gyvv.top",
      "custom_domain": true
    }
  ],
  "vars": {
    "RUNTIME_MODE": "d1",
    "ADMIN_USERNAME": "admin",
    "ALLOWED_ORIGIN": "https://fluxvault.gyvv.top",
    "ADMIN_HOST": "vault-admin.gyvv.top",
    "PUBLIC_HOST": "vault-api.gyvv.top"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "a90cbf72-3293-43c2-b4b3-a599eb778380",
      "migrations_dir": "../../database/migrations"
    }
  ]
}
